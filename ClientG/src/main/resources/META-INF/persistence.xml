<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <persistence-unit name="mysql">
        <provider>org.hibernate.reactive.provider.ReactivePersistenceProvider</provider>

        <class>com.blacicada.entity.Length</class>

        <properties>

            <!-- MySQL -->
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:mysql://192.168.31.78:3306/proxy?nullCatalogMeansCurrent=true&amp;useUnicode=true&amp;characterEncoding=utf-8&amp;serverTimezone=Asia/Shanghai"/>

            <!-- Credentials -->
            <property name="javax.persistence.jdbc.user"
                      value="root"/>
            <property name="javax.persistence.jdbc.password"
                      value="3asoynoub42LSow"/>

            <!-- The Vert.x SQL Client connection pool size -->
            <property name="hibernate.connection.pool_size"
                      value="1"/>
            <property name="hibernate.vertx.pool.connect_timeout" value="1000"/>

            <!-- Automatic schema export -->
            <property name="javax.persistence.schema-generation.database.action"
                      value="none"/>

            <!-- SQL statement logging -->
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.show_sql" value="false"/>

        </properties>

    </persistence-unit>

</persistence>
