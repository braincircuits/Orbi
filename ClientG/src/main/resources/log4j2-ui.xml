<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="ui" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %msg%n"/>
        </Console>
    </Appenders>
    <Loggers><Root level="info"><AppenderRef ref="ui"/></Root></Loggers>
</Configuration>
