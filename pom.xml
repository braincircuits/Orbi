<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.m20891.proxy</groupId>
    <artifactId>network</artifactId>
    <packaging>pom</packaging>
    <name>Orbi</name>
    <description>Orbi 多路复用代理与局域网流量管理项目</description>
    <version>1.0-SNAPSHOT</version>
    <modules>
        <module>Server</module>
        <module>ClientG</module>
        <module>ProxyCommon</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <netty>4.2.18.Final</netty>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <log4j>2.24.2</log4j>
        <disruptor>3.4.4</disruptor>
        <junit>5.8.2</junit>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j}</version>
            </dependency>
            <dependency>
                <groupId>com.lmax</groupId>
                <artifactId>disruptor</artifactId>
                <version>${disruptor}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration><argLine>--enable-native-access=ALL-UNNAMED -Dio.netty.leakDetection.level=paranoid</argLine></configuration>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>local-maven</id>
            <name>maven-releases</name>
            <url>http://192.168.31.78:8081/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>local-maven</id>
            <name>maven-snapshots</name>
            <url>http://192.168.31.78:8081/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
