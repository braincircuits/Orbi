@echo off
setlocal
cd /d "%~dp0"
set "app_options="
if "@APP@"=="client" set "app_options=--web --config"
if defined JAVA_HOME (
    "%JAVA_HOME%\bin\java.exe" --enable-native-access=ALL-UNNAMED -jar "%~dp0@APP@.jar" %app_options% "%~dp0config\@CONFIG@"
) else (
    java --enable-native-access=ALL-UNNAMED -jar "%~dp0@APP@.jar" %app_options% "%~dp0config\@CONFIG@"
)
exit /b %errorlevel%
